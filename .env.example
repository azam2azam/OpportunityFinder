# Copy to .env and fill in before running.

# Prisma connection string. SQLite by default; the schema is written to be
# portable to Postgres, so a postgresql:// URL works with a provider change.
DATABASE_URL="file:./opportuna.db"

# Signing key for session cookies. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-value"
